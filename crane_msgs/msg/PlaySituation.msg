uint8 OUR_BALL_PLACEMENT = 19

uint8 THEIR_KICKOFF_PREPARATION = 21
uint8 THEIR_KICKOFF_START = 22
uint8 THEIR_PENALTY_PREPARATION = 23
uint8 THEIR_PENALTY_START = 24
uint8 THEIR_DIRECT_FREE = 25
