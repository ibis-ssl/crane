std_msgs/Header header

# FIXME 多分本当はreferee系メッセージの大元で定義するべき
uint8 HALT = 0
uint8 STOP = 1
uint8 OUR_KICKOFF_PREPARATION = 11
uint8 OUR_KICKOFF_START = 12
uint8 OUR_PENALTY_PREPARATION = 13
uint8 OUR_PENALTY_START = 14
uint8 OUR_DIRECT_FREE = 15
