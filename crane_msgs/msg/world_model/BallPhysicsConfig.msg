# BallPhysicsModel設定パラメータ
# crane_physics/BallPhysicsModel::Configに対応

float64 deceleration         # 転がり時の減速度 (m/s²)
float64 gravity             # 重力加速度 (m/s²)  
float64 air_resistance      # 空気抵抗係数
float64 height_threshold    # 飛行判定の高度閾値 (m)
float64 speed_threshold     # 移動判定の速度閾値 (m/s)
float64 stop_threshold      # 停止判定の速度閾値 (m/s)