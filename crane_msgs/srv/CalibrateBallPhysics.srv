# ボール物理パラメータキャリブレーションサービス

# リクエスト
string rosbag_path                      # ROSBAGファイルのパス
bool optimize_physics true              # 物理パラメータの最適化を実行
bool optimize_kicker true               # キッカーモデルの最適化を実行
bool generate_report false              # 品質レポートの生成
string output_config_path               # 出力設定ファイルパス（空の場合はデフォルト）

# 最適化設定（オプション）
float64 min_kick_speed 0.8              # 最小キック速度閾値 [m/s]
float64 min_deceleration 0.1            # 最小減速度 [m/s²]
float64 max_deceleration 1.5            # 最大減速度 [m/s²]
int32 min_trajectory_points 8           # 最小軌道点数
bool extract_straight_kicks_only true   # ストレートキックのみ抽出

---

# レスポンス
bool success                            # キャリブレーション成功フラグ
string message                          # 結果メッセージ

# 最適化結果
float64 optimized_deceleration 0.0      # 最適化された減速度 [m/s²]
float64 physics_rmse 0.0               # 物理モデルRMSE [m]
float64 physics_r_squared 0.0          # 物理モデルR²

# キッカーモデル結果
float64 kicker_linear_coeff 0.0        # キッカー線形係数
float64 kicker_offset 0.0              # キッカーオフセット
float64 kicker_r_squared 0.0           # キッカーモデルR²

# 統計情報
int32 total_kick_events 0              # 検出されたキックイベント数
int32 valid_trajectories 0             # 有効な軌道数
int32 data_points_used 0               # 最適化に使用されたデータ点数

# 検証メトリクス
float64 validation_rmse 0.0            # 検証データのRMSE [m]
float64 speed_prediction_error 0.0     # 速度予測誤差 [m/s]
bool validation_passed false           # 検証合格フラグ

string output_file_path                 # 出力されたファイルパス
string quality_report                   # 品質レポート（generate_report=trueの場合）