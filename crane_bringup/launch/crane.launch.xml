<launch>
  <!-- ============================================================ -->
  <!-- ネットワーク設定 -->
  <!-- ============================================================ -->
  <arg name="packet_type" default="ibis" description="Packet type: ibis (binary) / ssl (RobotControl protobuf). Unknown values (including the removed 'grsim') fall back to ibis with a warning."/>

  <!-- ============================================================ -->
  <!-- チーム/動作モード設定 -->
  <!-- ============================================================ -->
  <arg name="team" default="ibis" description="チーム名"/>
  <arg name="sim" default="true" description="シミュレータフラグ（true: シミュレーション, false: 実機）"/>
  <arg name="planner" default="rvo2" description="局所経路計画アルゴリズム (rvo2 または visibility_graph)"/>
  <arg name="team_color" default="YELLOW" description="Referee受信前の初期チーム色 (YELLOW または BLUE)"/>

  <!-- ============================================================ -->
  <!-- ネットワークポート/アドレス自動設定（sim引数に基づく） -->
  <!-- ============================================================ -->
  <!-- sim=true の場合（ローカルシミュレーション） -->
  <let name="ibis_target_address" value="127.0.0.1" if="$(var sim)"/>
  <let name="vision_port" value="10020" if="$(var sim)"/>
  <let name="referee_port" value="11003" if="$(var sim)"/>

  <!-- sim=false の場合（実機ネットワーク） -->
  <let name="ibis_target_address" value="192.168.20.255" unless="$(var sim)"/>
  <let name="vision_port" value="10006" unless="$(var sim)"/>
  <let name="referee_port" value="10003" unless="$(var sim)"/>

  <!-- 共通固定設定 -->
  <let name="tracker_port" value="11010"/>
  <let name="ibis_target_port" value="12345"/>

  <!-- 使用ポート情報の表示 -->
  <log message="[crane.launch.xml] sim=$(var sim), team=$(var team), initial_color=$(var team_color) | Ports: Vision=$(var vision_port), Referee=$(var referee_port), Tracker=$(var tracker_port)"/>

  <!-- ============================================================ -->
  <!-- ロボット性能パラメータ -->
  <!-- ============================================================ -->
  <arg name="max_vel" default="6.0" description="ロボットの最大速度 [m/s]"/>

  <!-- Slack時間計算パラメータ -->
  <arg name="slack.robot_max_acceleration" default="1.0" description="slack時間計算に用いるロボットの最大加速度 [m/s^2]"/>
  <arg name="slack.robot_max_velocity" default="5.0" description="slack時間計算に用いるロボットの最大速度 [m/s]"/>
  <arg name="slack.time_horizon" default="3.0" description="ボール軌道予測時間範囲 [s]"/>
  <arg name="slack.time_step" default="0.1" description="ボール軌道サンプリング時間間隔 [s]"/>
  <arg name="slack.slack_time_offset" default="0.5" description="slack時間の安全マージン [s]"/>
  <arg name="slack.distance_horizon" default="15.0" description="slack時間評価の距離範囲 [m]"/>
  <arg name="slack.velocity_epsilon" default="0.2" description="ボール静止判定の速度閾値 [m/s]"/>

  <!-- ============================================================ -->
  <!-- 加減速度パラメータ -->
  <!-- ============================================================ -->
  <!-- ロボット送信用の加速度パラメータ -->
  <arg name="robot_acceleration.acceleration" default="6.0" description="加速時の加速度 [m/s^2]"/>
  <arg name="robot_acceleration.deceleration_high" default="3.0" description="減速時・高速域の減速度 [m/s^2]"/>
  <arg name="robot_acceleration.deceleration_low" default="3.0" description="減速時・低速域の減速度 [m/s^2]"/>
  <arg name="robot_acceleration.velocity_threshold" default="1.0" description="高速域・低速域のしきい値 [m/s]"/>

  <!-- 経路計画用の減速度パラメータ（実行側の90%以下に設定して計画と実行の不一致によるオーバーシュートを防止） -->
  <arg name="planning_deceleration" default="1.2" description="減速計算用の減速度 [m/s^2]"/>
  <!-- 経路計画用の加速度パラメータ（加速フェーズ専用、減速度より高い値を設定可能） -->
  <arg name="planning_acceleration" default="3.0" description="加速フェーズの計画用加速度 [m/s^2]"/>

  <!-- ============================================================ -->
  <!-- フィールド/試合設定 -->
  <!-- ============================================================ -->
  <arg name="is_emplace_positive_side" default="true" description="ロボットの退場方向（true: +X側, false: -X側）"/>

  <!-- ============================================================ -->
  <!-- 機能フラグ -->
  <!-- ============================================================ -->
  <arg name="speak" default="true" description="音声ノードの起動フラグ"/>
  <arg name="commentary" default="false" description="実況システムの起動フラグ"/>
  <arg name="record" default="true" description="rosbag記録フラグ"/>
  <arg name="emplace_robot_voice_announcement" default="true" description="ロボット退場時の音声アナウンス（true: 音声, false: ビープ音）"/>
  <arg name="ball_physics_config_path" default="grsim_ball_physics.yaml" description="ボール物理パラメータ設定ファイル名（configフォルダ内）"/>
  <arg name="field_geometry" default="B" description="フィールドジオメトリ設定: A (Division A), B (Division B), vision (Visionから取得)"/>

  <!-- フィールドジオメトリ設定の解決 -->
  <let name="field_geometry_config_path" value="field_geometry_div_a.yaml" if="$(eval '\'$(var field_geometry)\' == \'A\'')"/>
  <let name="field_geometry_config_path" value="field_geometry_div_b.yaml" if="$(eval '\'$(var field_geometry)\' == \'B\'')"/>
  <let name="field_geometry_config_path" value="" if="$(eval '\'$(var field_geometry)\' == \'vision\'')"/>

  <!-- ============================================================ -->
  <!-- コアシステム -->
  <!-- ============================================================ -->
  <node pkg="crane_session_coordinator" exec="crane_session_coordinator_node" output="screen">
    <param name="initial_session" value="HALT"/>
    <param name="event_config_file_name" value="normal.yaml"/>
    <param name="slack.robot_max_acceleration" value="$(var slack.robot_max_acceleration)"/>
    <param name="slack.robot_max_velocity" value="$(var slack.robot_max_velocity)"/>
    <param name="slack.time_horizon" value="$(var slack.time_horizon)"/>
    <param name="slack.time_step" value="$(var slack.time_step)"/>
    <param name="slack.slack_time_offset" value="$(var slack.slack_time_offset)"/>
    <param name="slack.distance_horizon" value="$(var slack.distance_horizon)"/>
    <param name="slack.velocity_epsilon" value="$(var slack.velocity_epsilon)"/>
    <param name="emplace_robot.use_voice_announcement" value="$(var emplace_robot_voice_announcement)"/>
  </node>

  <!-- ============================================================ -->
  <!-- プランニング/制御系 -->
  <!-- ============================================================ -->
  <!-- local_planner: シミュレータ用設定 -->
  <group if="$(var sim)">
    <node pkg="crane_local_planner" exec="crane_local_planner_node" output="screen">
      <param name="planner" value="$(var planner)"/>
      <param name="max_vel" value="$(var max_vel)"/>
      <param name="planning_deceleration" value="$(var planning_deceleration)"/>
      <param name="planning_acceleration" value="$(var planning_acceleration)"/>
      <param name="rvo_radius" value="0.15"/>
      <param name="velocity_damping_gain" value="0.0"/>
      <param name="update_rate_hz" value="0.0"/>
      <!-- KickerModel統合：YAML設定ファイルから読み込み -->
      <param name="kicker_physics_config" value="$(find-pkg-share crane_world_model_publisher)/config/kicker_physics.yaml"/>
    </node>
  </group>

  <!-- local_planner: 実機用設定 -->
  <group unless="$(var sim)">
    <node pkg="crane_local_planner" exec="crane_local_planner_node" output="screen">
      <param name="planner" value="$(var planner)"/>
      <param name="max_vel" value="$(var max_vel)"/>
      <param name="planning_deceleration" value="$(var planning_deceleration)"/>
      <param name="planning_acceleration" value="$(var planning_acceleration)"/>
      <param name="velocity_damping_gain" value="0.1"/>
      <param name="update_rate_hz" value="0.0"/>
      <param name="straight_kick_power_array" value="[0.0, 0.3, 0.6, 1.0]"/>
      <param name="straight_kick_speed_array" value="[0.0, 2.0, 4.0, 7.5]"/>
      <param name="chip_kick_power_array" value="[0.0, 0.5, 0.8]"/>
      <param name="chip_kick_distance_array" value="[0.0, 1.5, 2.5]"/>
    </node>
  </group>

  <!-- sender パラメータ: sim フラグに基づく条件値を let で事前解決 -->
  <!-- param タグは if/unless をサポートしないため let で分岐する -->
  <let name="sender_latency_ms" value="0.0" if="$(var sim)"/>
  <let name="sender_latency_ms" value="100.0" unless="$(var sim)"/>
  <let name="sender_kick_power_limit_straight" value="1.0" if="$(var sim)"/>
  <let name="sender_kick_power_limit_straight" value="0.5" unless="$(var sim)"/>

  <!-- sender: 統合（packet_typeでプロトコルを切り替え） -->
  <node pkg="crane_sender" exec="ibis_sender_node">
    <param name="no_movement" value="false"/>
    <!-- sim_mode は ibis_sender_node からは参照されていない（dead param）。feedback 受信とは無関係。 -->
    <param name="sim_mode" value="$(var sim)"/>
    <param name="packet_type" value="$(var packet_type)"/>
    <param name="target_address" value="$(var ibis_target_address)"/>
    <param name="target_port" value="$(var ibis_target_port)"/>
    <param name="latency_ms" value="$(var sender_latency_ms)"/>
    <param name="kick_power_limit_straight" value="$(var sender_kick_power_limit_straight)"/>
    <param name="kick_power_limit_chip" value="1.0"/>
    <param name="chip_angle_deg" value="30.0"/>
    <param name="theta_p_gain" value="3.0"/>
    <param name="position_control.kp" value="2.0"/>
    <param name="position_control.deceleration" value="$(var robot_acceleration.deceleration_high)"/>
    <param name="position_control.tolerance" value="0.01"/>
    <param name="robot_acceleration.acceleration" value="$(var robot_acceleration.acceleration)"/>
    <param name="robot_acceleration.deceleration_high" value="$(var robot_acceleration.deceleration_high)"/>
    <param name="robot_acceleration.deceleration_low" value="$(var robot_acceleration.deceleration_low)"/>
    <param name="robot_acceleration.velocity_threshold" value="$(var robot_acceleration.velocity_threshold)"/>
  </node>

  <!-- ============================================================ -->
  <!-- 通信系 -->
  <!-- ============================================================ -->
  <node pkg="robocup_ssl_comm" exec="game_controller_node">
    <param name="multicast_address" value="224.5.23.1"/>
    <param name="multicast_port" value="$(var referee_port)"/>
  </node>

  <group unless="$(var sim)">
    <node pkg="crane_robot_receiver" exec="ping_status_node"/>
  </group>

  <node pkg="crane_game_analyzer" exec="crane_game_analyzer_node" output="screen">
    <param name="ball_physics_config_path" value="$(var ball_physics_config_path)"/>
  </node>

  <node pkg="crane_robot_receiver" exec="robot_receiver_node" output="screen" respawn="true">
    <param name="max_robot_id" value="11"/>
  </node>

  <!-- Webデバッガー（ブラウザ http://localhost:8090 でアクセス可能） -->
  <node pkg="crane_web_debugger" exec="crane_websocket_server" output="screen"/>

  <!-- 可視化情報の集約 -->
  <node pkg="crane_visualization_interfaces" exec="visualization_aggregator_node" output="screen"/>

  <!-- ワールドモデル（世界状態の推定と管理） -->
  <node pkg="crane_world_model_publisher" exec="crane_world_model_publisher_node" output="screen">
    <param name="initial_team_color" value="$(var team_color)"/>
    <param name="team_name" value="$(var team)"/>
    <param name="vision_address" value="224.5.23.2"/>
    <param name="vision_port" value="$(var vision_port)"/>
    <param name="tracker_address" value="224.5.23.2"/>
    <param name="tracker_port" value="$(var tracker_port)"/>
    <param name="is_emplace_positive_side" value="$(var is_emplace_positive_side)"/>
    <param name="slack.robot_max_acceleration" value="$(var slack.robot_max_acceleration)"/>
    <param name="slack.robot_max_velocity" value="$(var slack.robot_max_velocity)"/>
    <param name="slack.time_horizon" value="$(var slack.time_horizon)"/>
    <param name="slack.time_step" value="$(var slack.time_step)"/>
    <param name="slack.slack_time_offset" value="$(var slack.slack_time_offset)"/>
    <param name="slack.distance_horizon" value="$(var slack.distance_horizon)"/>
    <param name="slack.velocity_epsilon" value="$(var slack.velocity_epsilon)"/>
    <param name="field_geometry_config_path" value="$(var field_geometry_config_path)"/>
  </node>

  <!-- プレイ選択（試合状況に応じた戦略切り替え） -->
  <node pkg="crane_play_switcher" exec="play_switcher_node" output="screen">
    <param name="team_name" value="$(var team)"/>
  </node>

  <!-- ============================================================ -->
  <!-- その他機能 -->
  <!-- ============================================================ -->
  <!-- 音声出力（条件付き起動） -->
  <group if="$(var speak)">
    <node pkg="crane_speaker" exec="crane_speaker_node"/>
    <!-- 音声合成エンジン -->
    <node pkg="speak_ros" exec="speak_ros_node">
      <param name="plugin_name" value="voicevox_plugin::VoiceVoxPlugin"/>
      <param name="voicevox_plugin/speaker" value="13"/>
      <param name="voicevox_plugin/speedScale" value="0.8"/>
      <param name="voicevox_plugin/volumeScale" value="1.0"/>
    </node>
  </group>

  <!-- 診断情報の配信 -->
  <node pkg="crane_robot_receiver" exec="diagnostic_publisher_node">
    <!-- ここは feedback_sim_mode ではなく sim に追従させる。このノードはソケットを開かず、
         sim_mode は「ping/feedback が無い状態を正常とみなすか」の診断判定にしか使わないため。 -->
    <param name="sim_mode" value="$(var sim)"/>
  </node>

  <!-- 診断情報の集約 -->
  <node pkg="diagnostic_aggregator" exec="aggregator_node" args="--ros-args --log-level FATAL">
    <param from="$(find-pkg-share crane_bringup)/config/diagnostic_aggregator.yaml"/>
  </node>

  <!-- 常時レイテンシ推定 -->
  <node pkg="crane_latency_estimator" exec="crane_latency_estimator_node" output="screen"/>

  <!-- ROSバッグ記録（条件付き起動） -->
  <!-- 記録対象トピックを選択的に指定し、zstd圧縮を有効化（容量削減: 4.9GiB → 推定0.5〜1.0GiB） -->
  <!-- 除外: /diagnostics（/diagnostics_aggで代替）, **/process_time, /parameter_events, /events/write_split -->
  <group if="$(var record)">
    <executable
      cmd="ros2 bag record -s mcap --compression-mode file --compression-format zstd --log-level fatal --topics /world_model /control_targets /robot_commands /game_analysis /robot_feedback /referee /play_situation /robot_select_results /game_event /kick_prediction_traces /rosout /aggregated_svgs /diagnostics_agg /ping /visualizer_svgs"
    />
  </group>

  <!-- Foxglove Bridge（可視化ツール連携） -->
  <include file="$(find-pkg-share crane_bringup)/launch/foxglove_bridge.launch.xml"/>
</launch>
